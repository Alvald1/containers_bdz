version: '3.8'

services:
{% for node in groups['swarm_managers'] %}
  etcd-{{ loop.index }}:
    image: {{ etcd_image }}
    command:
      - /usr/local/bin/etcd
      - --name=etcd-{{ loop.index }}
      - --data-dir=/etcd-data
      - --listen-client-urls=http://0.0.0.0:2379
      - --advertise-client-urls=http://etcd-{{ loop.index }}:2379
      - --listen-peer-urls=http://0.0.0.0:2380
      - --initial-advertise-peer-urls=http://etcd-{{ loop.index }}:2380
      - --initial-cluster=etcd-1=http://etcd-1:2380,etcd-2=http://etcd-2:2380,etcd-3=http://etcd-3:2380
      - --initial-cluster-token={{ stack_name }}-etcd
      - --initial-cluster-state=new
    volumes:
      - /srv/bdz/etcd:/etcd-data
    networks: [coordination]
    healthcheck:
      # Swarm publishes service DNS only after the first successful healthcheck.
      # Requiring quorum here prevents the peers from discovering one another.
      # Ansible checks every member's quorum readiness after deployment.
      disable: true
    deploy:
      replicas: 1
      placement:
        constraints: [node.labels.bdz_node == {{ node }}]
      resources:
        limits:
          memory: 512M
      restart_policy:
        delay: 5s
      update_config:
        order: stop-first

  postgres-{{ loop.index }}:
    image: {{ registry_endpoint }}/postgres:{{ gitlab_postgres_build_tag }}
    environment:
      PG_NODE_NAME: postgres-{{ loop.index }}
    volumes:
      - /srv/bdz/postgres:/var/lib/postgresql/data
    networks: [database, coordination]
    secrets:
{% for secret in ['postgres_password', 'replication_password', 'patroni_api_password', 'gitlab_db_password'] %}
      - source: {{ secret }}
        target: {{ secret }}
        uid: '999'
        gid: '999'
        mode: 0400
{% endfor %}
    stop_grace_period: 60s
    deploy:
      replicas: 1
      placement:
        constraints: [node.labels.bdz_node == {{ node }}]
      resources:
        limits:
          memory: 1G
      restart_policy:
        delay: 10s
      update_config:
        order: stop-first
{% endfor %}

  postgres:
    image: {{ haproxy_image }}
    configs:
      - source: haproxy
        target: /usr/local/etc/haproxy/haproxy.cfg
    networks: [backend, database]
    deploy:
      replicas: 3
      placement:
        max_replicas_per_node: 1
      resources:
        limits:
          memory: 128M
      update_config:
        parallelism: 1
        delay: 5s
        order: stop-first

  gitlab:
    image: {{ gitlab_image }}
    hostname: {{ gitlab_external_url | urlsplit('hostname') }}
    environment:
      GITLAB_OMNIBUS_CONFIG: "from_file('/omnibus_config.rb')"
    configs:
      - source: gitlab
        target: /omnibus_config.rb
    secrets:
      - gitlab_root_password
      - gitlab_db_password
    volumes:
      - /srv/bdz/gitlab/config:/etc/gitlab
      - /srv/bdz/gitlab/logs:/var/log/gitlab
      - /srv/bdz/gitlab/data:/var/opt/gitlab
      - type: tmpfs
        target: /dev/shm
        tmpfs:
          size: 268435456
    networks: [frontend, backend]
    ports:
      - target: 22
        published: {{ gitlab_ssh_port }}
        protocol: tcp
        mode: ingress
    healthcheck:
      test: [CMD, /opt/gitlab/bin/gitlab-healthcheck, --fail, --max-time, '10']
      interval: 30s
      timeout: 15s
      start_period: 600s
      retries: 10
    stop_grace_period: 120s
    deploy:
      replicas: 1
      placement:
        constraints: [node.labels.bdz_node == {{ gitlab_data_node }}]
      resources:
        limits:
          memory: 6G
      update_config:
        order: stop-first

  nginx:
    image: {{ nginx_image }}
    configs:
      - source: nginx
        target: /etc/nginx/conf.d/default.conf
    networks: [frontend]
    ports:
      - target: 80
        published: {{ gitlab_http_port }}
        protocol: tcp
        mode: ingress
    deploy:
      replicas: 3
      placement:
        max_replicas_per_node: 1
      resources:
        limits:
          memory: 128M
      update_config:
        parallelism: 1
        delay: 5s
        order: stop-first

networks:
{% for name, subnet in [('frontend', '172.30.10.0/24'), ('backend', '172.30.20.0/24'), ('database', '172.30.30.0/24'), ('coordination', '172.30.40.0/24')] %}
  {{ name }}:
    driver: overlay
    ipam:
      config:
        - subnet: {{ subnet }}
{% endfor %}

configs:
  gitlab:
    external: true
    name: {{ gitlab_config.config_name }}
  nginx:
    external: true
    name: {{ gitlab_nginx_config.config_name }}
  haproxy:
    external: true
    name: {{ gitlab_haproxy_config.config_name }}

secrets:
{% for secret in ['postgres_password', 'replication_password', 'patroni_api_password', 'gitlab_db_password', 'gitlab_root_password'] %}
  {{ secret }}:
    external: true
    name: {{ stack_name }}_{{ secret }}
{% endfor %}
