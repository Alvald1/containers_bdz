# Только публичный ключ, одной строкой. Секреты передаются через окружение.
ssh_public_key = "ВСТАВЬТЕ_СОДЕРЖИМОЕ_СВОЕГО_КЛЮЧА.pub"

# Прямой SSH на три ВМ с любого IPv4 разрешён пользователем.
admin_cidr = "0.0.0.0/0"

# Начальные одинаковые размеры трёх ВМ.
vm_cpu       = 2
vm_ram_gb    = 8
boot_disk_gb = 60

# При неоднозначном каталоге укажите image_id и/или flavor_name.
# image_id = "идентификатор Ubuntu 24.04 из каталога mephi"
# flavor_name = "точное имя флейвора"
